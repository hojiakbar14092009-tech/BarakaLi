{
  "name": "@barakali/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "catering:images": "node scripts/catering-images.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli/seed.ts",
    "db:audit-orders": "tsx --env-file-if-exists=../../.env src/db/cli/audit-orders.ts"
  },
  "dependencies": {
    "@barakali/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@gltf-transform/core": "^4.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.0",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "sharp": "^0.34.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "vitest": "^3.2.7"
  }
}
