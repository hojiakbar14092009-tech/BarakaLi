# --- API ---
NODE_ENV=development
PORT=3001
# Web origin(s) allowed by CORS, comma separated
ALLOWED_ORIGINS=http://localhost:5173
# Empty DATABASE_URL in development => embedded PostgreSQL (PGlite) in .data/pglite
DATABASE_URL=
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Comma separated phones (+998...) that become admin on first login
ADMIN_PHONES=
# console | (eskiz and playmobile adapters: see docs/TODO.md)
SMS_PROVIDER=console
# true => the verification code is returned in the API response.
# Insecure: only for hackathon previews where no SMS gateway is connected.
EXPOSE_SMS_CODE=false
# true => on first start add sample workers and products (idempotent)
SEED_SAMPLE_DATA=false
PAYMENT_PROVIDER=internal
STORAGE_PROVIDER=db
# --- WEB (build time) ---
VITE_API_URL=/api
